<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">#73FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Theme.PadLink" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">#FF0A1120</item>
        <item name="android:navigationBarColor">#FF0A1120</item>
    </style>
</resources>
